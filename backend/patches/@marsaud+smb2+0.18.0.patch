+/* ASN.1 DER helpers -------------------------------------------------------- */
+function derLen(n) {
+  if (n < 0x80) return Buffer.from([n]);
+  if (n < 0x100) return Buffer.from([0x81, n]);
+  return Buffer.from([0x82, (n >> 8) & 0xff, n & 0xff]);
+}
+function der(tag, content) {
+  return Buffer.concat([Buffer.from([tag]), derLen(content.length), content]);
