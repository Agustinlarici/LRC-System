+  var ntlmOid = der(0x06, Buffer.from('2b0601040182370202 0a'.replace(/\s/g, ''), 'hex'));
+  var mechTypes = der(0xa0, der(0x30, ntlmOid));        // [0] mechTypes
+  var mechToken = der(0xa2, der(0x04, ntlmToken));       // [2] mechToken
+  var negInit   = der(0xa0, der(0x30, Buffer.concat([mechTypes, mechToken]))); // [0] negTokenInit
+  // OID 1.3.6.1.5.5.2 (SPNEGO)
+  var spnegoOid = der(0x06, Buffer.from('2b06010505 02'.replace(/\s/g, ''), 'hex'));
+  return der(0x60, Buffer.concat([spnegoOid, negInit])); // APPLICATION [0]
+}
