+  var NTLMSSP = Buffer.from('4e544c4d53535000', 'hex');
+  if (buf.slice(0, 8).equals(NTLMSSP)) return buf;
+  var idx = buf.indexOf(NTLMSSP);
+  return idx >= 0 ? buf.slice(idx) : buf;
+}
