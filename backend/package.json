{
  "name": "lrc-system-backend",
  "version": "1.0.0",
  "description": "LRC-System Backend — Hono + Node.js + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --packages=external",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "@marsaud/smb2": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.6.0",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^4.76.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.5",
    "undici": "^8.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.27.4",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  }
}
