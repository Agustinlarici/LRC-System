{
  "name": "lrc-system-backend",
  "version": "1.0.0",
  "description": "LRC-System Backend — Hono + Node.js + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --packages=external",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^2.1.6",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.6.0",
    "docxtemplater": "^3.71.1",
    "hono": "^4.13.16",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pizzip": "^3.3.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "esbuild": "^0.28.2",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
