# ══════════════════════════════════════════════════════════════════
# LRC System — Production Environment Template
# Copia questo file in .env e compila tutti i valori
# ══════════════════════════════════════════════════════════════════

# ─── IP / URL del server ──────────────────────────────────────────
# L'indirizzo IP o hostname del server, come raggiunto dai browser in rete
SERVER_IP=192.168.1.183

# URL pubblico del backend (come lo vede il browser client, NON Docker interno)
NEXT_PUBLIC_API_URL=http://192.168.1.183:3001

# Origini CORS permesse (separare con virgola se ce ne sono più)
CORS_ORIGINS=http://192.168.1.183:3000

# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=lrc_system
POSTGRES_USER=lrc
POSTGRES_PASSWORD=cambia_questa_password

# ─── Business Central (SQL Server) ───────────────────────────────
# Per la sincronizzazione articoli — scheduler gira alle 03:00
BC_SERVER=192.168.1.x
BC_DATABASE=STR
BC_USER=sa
BC_PASSWORD=cambia_questa_password

# ─── WebThron (MySQL) ─────────────────────────────────────────────
# Per i dati del monitor di produzione
WEBTHRON_HOST=192.168.1.12
WEBTHRON_PORT=3306
WEBTHRON_DB=WebThron
WEBTHRON_USER=
WEBTHRON_PASS=
WEBTHRON_TZ=+01:00

# ─── Opzionale ────────────────────────────────────────────────────
OPENAI_API_KEY=
