# ══════════════════════════════════════════════════════════════════
# LRC System — Production Environment Template
# Copia questo file in .env e compila tutti i valori
# ══════════════════════════════════════════════════════════════════

# ─── IP / URL del server ──────────────────────────────────────────
# L'indirizzo IP o hostname del server, come raggiunto dai browser in rete
SERVER_IP=192.168.1.183

# URL pubblico del backend (come lo vede il browser client, NON Docker interno)
NEXT_PUBLIC_API_URL=http://192.168.1.183:3001

# Origini CORS permesse (separare con virgola se ce ne sono più)
CORS_ORIGINS=http://192.168.1.183:3000

# ─── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=lrc_system
POSTGRES_USER=lrc
POSTGRES_PASSWORD=cambia_questa_password

# ─── Business Central (SQL Server) ───────────────────────────────
# Per la sincronizzazione articoli — scheduler gira alle 03:00
BC_SERVER=192.168.1.x
BC_DATABASE=STR
BC_USER=sa
BC_PASSWORD=cambia_questa_password

# ─── WebThron (MySQL) ─────────────────────────────────────────────
# Per i dati del monitor di produzione
WEBTHRON_HOST=192.168.1.12
WEBTHRON_PORT=3306
WEBTHRON_DB=WebThron
WEBTHRON_USER=
WEBTHRON_PASS=
WEBTHRON_TZ=+01:00

# ─── JWT (Ticket IT) ──────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_questa_chiave_segreta

# ─── Ricezione DDT — Scanner ingresso ────────────────────────────
# INTEGRAZIONE CLAUDE DISABILITATA — in attesa di approvazione sicurezza informatica.
# La variabile è mantenuta come riferimento. Il watcher invia tutti i DDT a revisione
# manuale finché l'integrazione non viene riabilitata (flag IA_DISABLED in ia.service.ts).
# API key Anthropic per estrarre dati dai DDT (claude-haiku-4-5)
# ANTHROPIC_API_KEY=

# Cartella sorvegliata dallo scanner (UNC su Windows, path montato su Linux/Docker)
# Esempio Windows dev: \\strlan.local\data\Pubblico\Scansioni Ingresso\STR5
# Esempio Docker:      /scansioni  (montare la share CIFS come volume)
SCAN_FOLDER=

# Cartella radice per i PDF archiviati (deve essere persistente)
DOCS_FOLDER=/documentos

# ─── Opzionale ────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Alerting — Telegram Bot ──────────────────────────────────────
# INTEGRAZIONE TELEGRAM DISABILITATA — in attesa di approvazione sicurezza informatica.
# Le variabili sono mantenute come riferimento. Per riabilitare: rimuovere il flag
# TELEGRAM_DISABLED in telegram-bot.ts e notifier.ts, e decommentare le righe qui sotto.
# 1. Crea un bot su Telegram con @BotFather → ottieni il TOKEN
# 2. Scrivi al bot /start, poi vai su: https://api.telegram.org/bot<TOKEN>/getUpdates
#    e leggi "chat":{"id": ...} per ottenere il CHAT_ID
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── SPMA — Bot Telegram dedicato ─────────────────────────────────────────────
# INTEGRAZIONE TELEGRAM SPMA DISABILITATA — in attesa di approvazione sicurezza informatica.
# Per riabilitare: rimuovere il flag SPMA_DISABLED in spma-notifier.ts e decommentare.
# Bot separato per gli avvisi di ritardo SPMA. Chat ID configurabile dall'UI.
# SPMA_TELEGRAM_BOT_TOKEN=

# ─── Alerting — Email (SMTP, opzionale) ───────────────────────────
# Indirizzo destinatario degli alert
ALERT_EMAIL_TO=
# Server SMTP (es. smtp.gmail.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mittente (lasciare vuoto per usare SMTP_USER)
SMTP_FROM=
