# ═══════════════════════════════════════════════════════════════════
# Config del sistema di aggiornamento automatico — LRC-System (host Ubuntu)
# Copiare in /etc/default/auto-update sul server e modificare li'.
# ═══════════════════════════════════════════════════════════════════

# "security" = solo patch di sicurezza (consigliato ora)
# "full"     = tutti gli aggiornamenti disponibili (apt full-upgrade)
UPDATE_MODE=security

# Ora di manutenzione (usata solo come riferimento nel timer systemd,
# vedi auto-update.timer per l'orario effettivo)
MAINTENANCE_WINDOW="03:00"

# Cartella dove si salvano backup di /etc, lista pacchetti e log
BACKUP_DIR=/var/backups/auto-update
LOG_DIR=/var/log/auto-update

# Giorni di retention per backup e log vecchi
RETENTION_DAYS=14

# Percentuale minima di spazio libero su / richiesta per procedere
MIN_FREE_DISK_PERCENT=15

# Servizi che DEVONO essere attivi dopo l'update per considerare
# l'aggiornamento riuscito (separati da spazio). Docker basta a coprire
# lo stack LRC-System, dato che i container hanno restart: unless-stopped.
CRITICAL_SERVICES="docker ssh"

# URL opzionale per un healthcheck HTTP dopo l'update (lasciare vuoto per
# saltare). Esempio: http://localhost:3001/health
HEALTHCHECK_URL=""
