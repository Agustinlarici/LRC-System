# ─── Business Central (SQL Server) ───────────────────────────────────────────
BC_SERVER=192.168.1.x
BC_DATABASE=STR
BC_USER=your_bc_user
BC_PASSWORD=your_bc_password
# BC_DOMAIN: valorizzare SOLO se BC_USER è un account di dominio Windows
# (es. STRSQL02 richiede autenticazione NTLM: BC_DOMAIN=STRLAN, BC_USER=usrnav).
BC_DOMAIN=

# ─── WebThron (MySQL) ─────────────────────────────────────────────────────────
WEBTHRON_HOST=192.168.1.x
WEBTHRON_PORT=3306
WEBTHRON_DB=WebThron
WEBTHRON_USER=your_webthron_user
WEBTHRON_PASS=your_webthron_password
WEBTHRON_TZ=+01:00
